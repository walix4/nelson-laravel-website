# DrayToll static hosting — caching + compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Content-hashed Next.js bundles — cache forever
  <FilesMatch "\.(js|css|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images & video — cache a week
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|mp4|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # HTML — always revalidate so deploys go live immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
